<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Internal application cache (context.cacheDir) for temporary audio, video, and exports -->
    <cache-path
        name="cache"
        path="." />

    <!-- Internal application private files (context.filesDir) -->
    <files-path
        name="files"
        path="." />

    <!-- External cache directory (context.externalCacheDir) -->
    <external-cache-path
        name="external_cache"
        path="." />

    <!-- External app-specific storage (context.getExternalFilesDir(null)) -->
    <external-files-path
        name="external_files"
        path="." />

    <!-- Shared external root (SD card / device storage root for media pickers and exported ZIPs) -->
    <external-path
        name="external_storage_root"
        path="." />
</paths>
